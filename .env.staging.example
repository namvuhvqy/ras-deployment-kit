# Copy to .env.staging on VPS and fill secrets there.
RAS_API_PORT=8080
RAS_DB_PATH=/data/ras-store.json
# API-only named-volume path; ras-worker must not receive this mount.
RAS_CHECKOUT_INTENTS_PATH=/checkout-intents/checkout-intents.json
ZERNIO_MODE=dry-run
# Non-secret, deployed-artifact/contract attestation for checkout-intent-v1.
# Set the exact source/artifact SHA during a separately approved Staging rollout.
RAS_BUILD_SHA=
RAS_CHECKOUT_CONTRACT_VERSION=checkout-intent-v1
# Public rotation label only; never place the relay token or fingerprint here.
RAS_RELAY_KEY_ID=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_API_KEY=
ZERNIO_TIMEOUT_MS=30000
RAS_WORKER_BATCH_SIZE=20
RAS_WORKER_IDLE_MS=5000
RAS_WORKER_MAX_RETRIES=5
RAS_WORKER_BASE_RETRY_MS=60000

# Dedicated RAS Redis only. Any generated password is accepted; the app URL-encodes it.
RAS_REDIS_PASSWORD=
RAS_PAT_RATE_LIMIT_PER_MINUTE=120

ZERNIO_WEBHOOK_SECRET=
