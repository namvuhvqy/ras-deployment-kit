{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zernio Webhook Payload Schemas for RunAgentSys",
  "description": "JSON Schemas and mock payloads for training and validating AI Agent integrations.",
  "version": "1.0.4",
  "definitions": {
    "InboxWebhookAccount": {
      "type": "object",
      "required": [
        "id",
        "accountId",
        "platform",
        "username"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Social account ID (legacy)"
        },
        "accountId": {
          "type": "string",
          "description": "Canonical SocialAccount ID for filtering"
        },
        "profileId": {
          "type": "string",
          "description": "Zernio profile (workspace) ID this account belongs to"
        },
        "platform": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "InboxWebhookConversation": {
      "type": "object",
      "required": [
        "id",
        "platformConversationId",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Internal Zernio conversation ID"
        },
        "platformConversationId": {
          "type": "string",
          "description": "Platform-native conversation ID"
        },
        "participantId": {
          "type": "string",
          "description": "Contact's platform identifier"
        },
        "participantName": {
          "type": "string"
        },
        "participantUsername": {
          "type": "string"
        },
        "participantPicture": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "archived"
          ]
        },
        "contactId": {
          "type": "string",
          "description": "Zernio CRM Contact ID if resolved"
        }
      }
    },
    "Attachment": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "file",
            "sticker",
            "share"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  },
  "events": {
