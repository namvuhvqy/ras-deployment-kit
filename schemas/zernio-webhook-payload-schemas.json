        "properties": {
          "id": {
            "type": "string",
            "description": "Stable webhook event ID"
          },
          "event": {
            "type": "string",
            "enum": [
              "webhook.test"
            ]
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
