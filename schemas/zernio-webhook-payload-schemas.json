                      "string",
                      "null"
                    ]
                  },
                  "businessScopedUserId": {
                    "type": "string"
                  }
                }
              },
              "sentAt": {
                "type": "string",
                "format": "date-time"
              },
              "isRead": {
                "type": "boolean"
              }
            }
          },
          "conversation": {
            "$ref": "#/definitions/InboxWebhookConversation"
          },
          "account": {
            "$ref": "#/definitions/InboxWebhookAccount"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
