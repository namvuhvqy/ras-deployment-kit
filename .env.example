# RAS Deployment Kit example env. Do not put real secrets in git.
RAS_CUSTOMER_ID=demo
RAS_DOMAIN=bot.example.com
ZERNIO_ENABLED=true
ZERNIO_BASE_URL=
ZERNIO_API_KEY=

# Google OAuth 2.0 (openid email profile only). Keep real values out of git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/auth/google/callback
FRONTEND_APP_URL=http://localhost:3000

# PayPal trusted capture relay. Sandbox is the only supported mode. These are
# server-only values; keep secrets in your deployment secret manager, not git.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RAS_INTERNAL_API_TOKEN=
RAS_PAYMENT_RELAY_ASSERTION_SECRET=
# Deployment-owned RAS API URL. HTTPS is required outside local/compose hosts.
RAS_INTERNAL_API_BASE_URL=http://ras-api:8080

GOG_ACCOUNT=
TELEGRAM_BOT_TOKEN=
OPENCLAW_BASE_URL=
HERMES_BASE_URL=
