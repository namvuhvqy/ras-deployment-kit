# RAS Deployment Kit example env. Do not put real secrets in git.
RAS_CUSTOMER_ID=demo
RAS_DOMAIN=bot.example.com
ZERNIO_ENABLED=true
ZERNIO_BASE_URL=
ZERNIO_API_KEY=

# Google OAuth 2.0 (openid email profile only). Keep real values out of git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/auth/google/callback
FRONTEND_APP_URL=http://localhost:3000
# Production: exact comma-separated HTTPS origins; callback must be registered at Google.
RAS_CANONICAL_ORIGIN=https://api.example.com
RAS_FRONTEND_ORIGINS=https://app.example.com
# Comma-separated rotating internal relay credentials; never log or commit values.
RAS_INTERNAL_API_TOKENS=

GOG_ACCOUNT=
TELEGRAM_BOT_TOKEN=
OPENCLAW_BASE_URL=
HERMES_BASE_URL=
